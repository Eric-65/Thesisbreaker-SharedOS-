# ThesisBreaker — environment configuration
#
# Copy to `.env.local` and fill in. Never commit a real credential.
#
# NOTHING in this file may be exposed through a NEXT_PUBLIC_* variable:
# every value here is read server-side only.

# ---------------------------------------------------------------------------
# SharedOS — execution, permissions, audit
# ---------------------------------------------------------------------------

# The single purpose string attached to every Arena turn and audit event.
# Keep this consistent across the product. Documented in docs/sharedos-arena.md.
SHAREDOS_PURPOSE=thesisbreaker.verify

# Resource + tool namespace owned by this product.
SHAREDOS_NAMESPACE=thesisbreaker

# Supplied by the hackathon organizers / SharedOS registration.
# The services execute without these; they are required to trade in the Arena
# under a verifiable identity.
SHAREDOS_TENANT_ID=
SHAREDOS_OWNER_ADDRESS=
SHAREDOS_AGENT_ADDRESS=

# Write kernel audit events to stderr as NDJSON. Set to "false" to silence.
SHAREDOS_AUDIT_STDERR=true

# ---------------------------------------------------------------------------
# SharedNet — Arena discovery, presence and credits
# ---------------------------------------------------------------------------

# From `sharednet whoami` after `sharednet login`.
SHAREDNET_NODE_ID=

# The Arena Room to join (rom_… or an invite code).
SHAREDNET_ROOM_ID=

# Override if the CLI is not on PATH (e.g. a local checkout).
# SHAREDNET_CLI=sharednet

# Set to "true" to run the Arena agent without posting to the Room.
ARENA_DRY_RUN=false

# ---------------------------------------------------------------------------
# Pricing (Arena credits)
# ---------------------------------------------------------------------------

PRICE_FREE_PREVIEW=0
PRICE_VERIFY_CLAIM=5
PRICE_BREAK_THESIS=10

# ---------------------------------------------------------------------------
# Service timeouts (milliseconds). The Arena ceiling is 5 minutes; these are
# deliberately far below it.
# ---------------------------------------------------------------------------

TIMEOUT_FREE_PREVIEW_MS=10000
TIMEOUT_VERIFY_CLAIM_MS=20000
TIMEOUT_BREAK_THESIS_MS=45000

# ---------------------------------------------------------------------------
# Bounded research. Disabled by default: the paid services work entirely from
# caller-supplied evidence, so no outbound request is required to serve a call.
# ---------------------------------------------------------------------------

THESISBREAKER_RESEARCH_ENABLED=false
THESISBREAKER_RESEARCH_MAX_FETCHES=0
THESISBREAKER_RESEARCH_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Database — OPTIONAL
#
# Used for thesis history and durable audit/usage persistence. The MCP server,
# the CLI and the Arena agent all run without it; audit then lives in the
# in-process ring buffer and stderr stream only.
# ---------------------------------------------------------------------------

DATABASE_URL=

# ---------------------------------------------------------------------------
# Binance Agent OS — OPTIONAL / LEGACY
#
# Not required for any Arena service. Enables the optional trading-execution
# screens only. The Arena product works with these unset.
# ---------------------------------------------------------------------------

BINANCE_AGENT_TOKEN=
BINANCE_AGENT_BASE_URL=
