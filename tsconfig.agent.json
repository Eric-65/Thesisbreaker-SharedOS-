{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/cli/**/*.ts",
    "src/mcp/**/*.ts",
    "src/arena/**/*.ts",
    "src/lib/arena/**/*.ts",
    "src/lib/sharedos/**/*.ts",
    "src/lib/services/**/*.ts",
    "src/lib/decision/**/*.ts",
    "src/db/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.tsx",
    "src/lib/binance/**",
    "src/lib/market/**",
    "src/lib/monitor.ts"
  ]
}